# Python bytecode — regenerated at runtime, never commit
__pycache__/
*.py[cod]
*$py.class

# Frappe build output — `bench build` regenerates these from public/scss with a
# content hash in the filename, so every rebuild churns git status. Ship the
# source (public/scss/*.bundle.scss); the bundles are built on deploy.
**/public/dist/

# Node & tooling
node_modules/

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp
